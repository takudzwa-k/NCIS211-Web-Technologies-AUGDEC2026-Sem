# Copy this file to ".env" (same folder) and fill in the mail lines. Then restart the server.
# Check it works with:  node server/test-mail.js your.address@example.com

# --- Sending real email -------------------------------------------------
# Example for Gmail (turn on 2-Step Verification, then create an "App password" at myaccount.google.com/apppasswords):
AU_SMTP_HOST=smtp.gmail.com
AU_SMTP_PORT=465
AU_SMTP_SECURE=ssl
AU_SMTP_USER=your.address@gmail.com
AU_SMTP_PASS=your-16-letter-app-password
AU_SMTP_FROM=AU Portal <your.address@gmail.com>

# Other providers: use the host, port and login they give you.
#   Port 465 -> AU_SMTP_SECURE=ssl      Port 587 -> AU_SMTP_SECURE=starttls

# --- Links inside emails --------------------------------------------------
# The address people use to reach the portal. Emails contain links built from this.
# On your own computer:     AU_BASE_URL=http://localhost:3000
# On a server people can reach, use its real address, for example https://portal.africau.edu
AU_BASE_URL=http://localhost:3000
